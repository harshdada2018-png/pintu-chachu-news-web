# Cloudflare Pages Static Asset Cache Policy

# Hashed Vite JS/CSS bundles are content-addressed and safe to cache long-term
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# SPA HTML entrypoints must always revalidate so new deploys pick up updated asset hashes immediately
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Static brand assets and media cached for 24 hours
/logo.png
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

/icons.svg
  Cache-Control: public, max-age=86400

/audio/*
  Cache-Control: public, max-age=86400

# AdSense publisher file cached for 1 hour so updates propagate quickly
/ads.txt
  Cache-Control: public, max-age=3600

