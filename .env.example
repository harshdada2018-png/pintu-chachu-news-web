# PublicSpark Backend Environment Configuration

# Server Port
PORT=5000

# Google Cloud Text-to-Speech API Key
# Enable "Cloud Text-to-Speech API" in Google Cloud Console -> APIs & Services
GOOGLE_CLOUD_TTS_API_KEY=YOUR_GOOGLE_CLOUD_TTS_API_KEY_HERE

# Google Cloud Translation API Key
# Enable "Cloud Translation API" in Google Cloud Console -> APIs & Services
GOOGLE_CLOUD_TRANSLATE_API_KEY=YOUR_GOOGLE_CLOUD_TRANSLATE_API_KEY_HERE

# Sarvam AI API Key (For Odia 'or' & Assamese 'as' Text-to-Speech)
# Obtain subscription key from https://sarvam.ai
SARVAM_AI_API_KEY=YOUR_SARVAM_AI_API_KEY_HERE
