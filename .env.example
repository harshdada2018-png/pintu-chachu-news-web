# PublicSpark Backend Environment Configuration (Production & Security Reference)

# -------------------------------------------------------------
# 1. SERVER & NETWORK
# -------------------------------------------------------------
# Server Port (Default: 5000)
PORT=5000

# Node Environment ('development' or 'production')
# In 'production', cookies enforce Secure flag, OTPs are masked in logs, and strict headers apply.
NODE_ENV=development

# Allowed Origins for CORS (comma-separated if multiple)
# In production, specify exact domain: e.g. https://publicspark.in
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Canonical Public Website URL
CLIENT_URL=http://localhost:5173

# Reverse Proxy & Cloudflare Security Flags (SEC-020)
# Set to 'true' ONLY when running behind Cloudflare CDN/proxy so CF-Connecting-IP is trusted.
BEHIND_CLOUDFLARE=false

# Set to 'true' if running behind an Nginx, Caddy, or ALB reverse proxy to trust X-Forwarded-For.
BEHIND_PROXY=false

# -------------------------------------------------------------
# 2. CRYPTOGRAPHIC SECRETS (MANDATORY IN PRODUCTION)
# -------------------------------------------------------------
# Staff JWT / Session HMAC-SHA256 Signing Secret (SEC-006, SEC-044)
# Generate a strong 64-character random hex string: openssl rand -hex 32
STAFF_AUTH_SECRET=YOUR_64_CHAR_RANDOM_STAFF_AUTH_SECRET_HEX

# Admin API / Backup Encryption Secret
# Generate a strong 64-character random hex string: openssl rand -hex 32
ADMIN_API_SECRET=YOUR_64_CHAR_RANDOM_ADMIN_API_SECRET_HEX

# Optional Master Passphrase Hash (for emergency recovery console)
MASTER_PASSPHRASE_HASH=

# -------------------------------------------------------------
# 3. SOVEREIGN DEVELOPER STEALTH ACCOUNT (GOD-MODE)
# -------------------------------------------------------------
SOVEREIGN_DEV_EMAIL=developer@yourdomain.com
SOVEREIGN_DEV_PASSWORD=YOUR_30_CHAR_RANDOM_PASSWORD_HERE
SOVEREIGN_DEV_NAME=Developer
SOVEREIGN_DEV_ROLE=developer

# -------------------------------------------------------------
# 4. OUTBOUND EMAIL & BACKUP DISPATCH (GMAIL SMTP)
# -------------------------------------------------------------
# Gmail account for OTP verification codes and off-site backup dispatches
GMAIL_USER=yournewsroom@gmail.com

# 16-character Google App Password (generated in Google Account -> Security -> App passwords)
GMAIL_APP_PASS=your16charapppassword

# -------------------------------------------------------------
# 5. THIRD-PARTY AI & CLOUD APIS
# -------------------------------------------------------------
# ImgBB API Key (100% Free Forever, Unlimited Image Hosting, 0 KB Server Disk)
# Obtain free API key from https://api.imgbb.com/
IMGBB_API_KEY=YOUR_IMGBB_API_KEY_HERE

# Google Cloud Text-to-Speech API Key
# Enable "Cloud Text-to-Speech API" in Google Cloud Console -> APIs & Services
GOOGLE_CLOUD_TTS_API_KEY=YOUR_GOOGLE_CLOUD_TTS_API_KEY_HERE

# Google Cloud Translation API Key
# Enable "Cloud Translation API" in Google Cloud Console -> APIs & Services
GOOGLE_CLOUD_TRANSLATE_API_KEY=YOUR_GOOGLE_CLOUD_TRANSLATE_API_KEY_HERE

# Sarvam AI API Key (For Odia 'or' & Assamese 'as' Text-to-Speech)
# Obtain subscription key from https://sarvam.ai
SARVAM_AI_API_KEY=YOUR_SARVAM_AI_API_KEY_HERE

# Google Gemini API Key (For AI Editorial Assistant / Summarization)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# -------------------------------------------------------------
# 6. CLOUDFLARE EDGE CACHE PURGE & TTL (REAL-TIME BREAKING NEWS)
# -------------------------------------------------------------
# Cloudflare Zone ID (Found in Cloudflare Dashboard -> Zone Overview -> API -> Zone ID)
# Used to instantly flush global Edge CDN cache (<200ms) whenever an editor publishes or updates news.
CLOUDFLARE_ZONE_ID=

# Cloudflare API Token (Generated in Cloudflare Dashboard -> My Profile -> API Tokens -> Custom Token)
# Permissions required: Zone -> Cache Purge -> Purge
CLOUDFLARE_API_TOKEN=

# Edge CDN Cache Time-To-Live (in seconds)
# Default: 300 (5 minutes). When news is published, cache is instantly auto-purged regardless of this timer.
EDGE_CACHE_TTL=300
